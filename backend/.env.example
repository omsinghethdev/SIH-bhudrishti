# Copy to .env and adjust. Never commit the real .env.

# --- Security -------------------------------------------------------------
# Generate one with:  python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me-generate-a-long-random-string
JWT_ALGORITHM=HS256
# Access-token lifetime in minutes (default 720 = 12 hours)
ACCESS_TOKEN_EXPIRE_MINUTES=720

# --- Database -------------------------------------------------------------
# SQLite for local development. To move to PostgreSQL later, just change this:
#   DATABASE_URL=postgresql+psycopg://user:password@localhost:5432/bhudrishti
DATABASE_URL=sqlite:///./bhudrishti.db

# --- CORS -----------------------------------------------------------------
# Comma-separated list of allowed frontend origins (scheme + host + port).
# Add whatever port you serve the frontend on.
FRONTEND_URL=http://localhost:5500,http://127.0.0.1:5500,http://localhost:8080,http://127.0.0.1:8080

# --- Uploads --------------------------------------------------------------
UPLOAD_DIR=./uploads
MAX_UPLOAD_MB=200
