# Copy to .env and fill in before `docker compose up`. Never commit .env.

# --- Security --------------------------------------------------------------
# python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=720

# --- Database (PostgreSQL service in docker-compose.yml) -------------------
POSTGRES_DB=bhudrishti
POSTGRES_USER=bhudrishti
POSTGRES_PASSWORD=

# --- Web -------------------------------------------------------------------
# Port nginx binds on the host. 80 locally; keep 80 behind an AWS ALB too.
HTTP_PORT=80
# Origins allowed by the backend's CORS layer. With the bundled nginx proxy the
# browser is always same-origin, so this only matters for direct API clients.
# On EC2 use your domain or public DNS, e.g. http://ec2-13-1-2-3.compute.amazonaws.com
FRONTEND_URL=http://localhost,http://127.0.0.1
# Leave empty so the browser calls its own origin via the nginx /api proxy.
# Set only when the API runs on a different host, e.g. https://api.example.com
API_BASE_URL=

# --- Runtime ---------------------------------------------------------------
MAX_UPLOAD_MB=200
WEB_CONCURRENCY=2
# Loads the MP Nagar demo dataset on first boot. Idempotent; set false in prod.
SEED_ON_START=true
